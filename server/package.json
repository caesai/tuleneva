{
  "name": "tuleneva_server",
  "version": "1.0.0",
  "description": "Server",
  "homepage": "https://github.com/caesai/tuleneva_server#readme",
  "bugs": {
    "url": "https://github.com/caesai/tuleneva_server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caesai/tuleneva_server.git"
  },
  "license": "MIT",
  "author": "Vasily Kharlamov",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.cjs",
  "scripts": {
    "test": "vitest run test/unit test/contracts",
    "test:integration": "vitest run test/integration",
    "test:all": "npm test && npm run test:integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.cjs",
    "dev": "tsx watch index.ts",
    "build": "esbuild index.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/index.cjs --banner:js=\"const __import_meta_url = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__import_meta_url"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.19.2",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.2",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
